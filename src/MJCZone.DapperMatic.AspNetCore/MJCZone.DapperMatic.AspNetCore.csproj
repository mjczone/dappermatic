<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Product>DapperMatic ASP.NET Core</Product>
    <PackageId>MJCZone.DapperMatic.AspNetCore</PackageId>
    <PackageTags>dotnet dapper mysql sqlserver postgresql sqlite aspnetcore webapi endpoints</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/mjczone/dappermatic/</PackageProjectUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <RepositoryUrl>https://github.com/mjczone/dappermatic/</RepositoryUrl>
    <Version>0.0.1</Version>
    <Summary>ASP.NET Core integration for DapperMatic - Web API endpoints for database schema management.</Summary>
    <Description>Provides ASP.NET Core Web API endpoints and middleware for database schema management using DapperMatic. Includes endpoints for tables, columns, indexes, constraints, and views across SQL Server, MySQL/MariaDB, PostgreSQL, and SQLite.</Description>
    <RootNamespace>MJCZone.DapperMatic.AspNetCore</RootNamespace>
    <AssemblyName>MJCZone.DapperMatic.AspNetCore</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DisableImplicitAspNetCoreAnalyzers>true</DisableImplicitAspNetCoreAnalyzers>
    <NoWarn>AD0001</NoWarn>
    <!-- License Information -->
    <PackageLicenseExpression>LGPL-3.0-or-later</PackageLicenseExpression>
    <Copyright>Copyright 2025 MJCZone Inc.</Copyright>
    <Authors>MJCZone Inc.</Authors>
    <Company>MJCZone Inc.</Company>
  </PropertyGroup>
  <ItemGroup>
    <!-- ASP.NET Core types for a class library using the non-Web SDK -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../MJCZone.DapperMatic/MJCZone.DapperMatic.csproj" />
  </ItemGroup>
  <!--
    This package uses DapperMatic's internals (its query engine), which change between versions: it depends on the exact
    version of MJCZone.DapperMatic it was built with, [x.y.z], never a range.
  -->
  <Target Name="PinDapperMaticVersion" AfterTargets="_GetProjectReferenceVersions">
    <ItemGroup>
      <_ProjectReferencesWithVersions Update="@(_ProjectReferencesWithVersions)" ProjectVersion="[%(_ProjectReferencesWithVersions.ProjectVersion)]" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>MJCZone.DapperMatic.AspNetCore.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>MJCZone.DapperMatic.GraphQL</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
  </ItemGroup>
</Project>
