<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Product>DapperMatic GraphQL</Product>
    <PackageId>MJCZone.DapperMatic.GraphQL</PackageId>
    <PackageTags>dotnet dapper mysql sqlserver postgresql sqlite aspnetcore graphql relay apollo</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/mjczone/dappermatic/</PackageProjectUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <RepositoryUrl>https://github.com/mjczone/dappermatic/</RepositoryUrl>
    <Version>0.0.1</Version>
    <Summary>GraphQL for DapperMatic: each caller's own schema of the tables they may use, over DapperMatic's engine and policies.</Summary>
    <Description>Adds a GraphQL endpoint to DapperMatic's ASP.NET Core integration, built with GraphQL.NET: queries, Relay connections and global IDs, mutations and live-query subscriptions over graphql-transport-ws, each run through DapperMatic's own query engine, policies, tenancy, caching and audit.</Description>
    <RootNamespace>MJCZone.DapperMatic.GraphQL</RootNamespace>
    <AssemblyName>MJCZone.DapperMatic.GraphQL</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DisableImplicitAspNetCoreAnalyzers>true</DisableImplicitAspNetCoreAnalyzers>
    <NoWarn>AD0001</NoWarn>
    <PackageLicenseExpression>LGPL-3.0-or-later</PackageLicenseExpression>
    <Copyright>Copyright 2025 MJCZone Inc.</Copyright>
    <Authors>MJCZone Inc.</Authors>
    <Company>MJCZone Inc.</Company>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../MJCZone.DapperMatic.AspNetCore/MJCZone.DapperMatic.AspNetCore.csproj" />
  </ItemGroup>
  <!--
    This package uses DapperMatic's internals (its engine, the caller model), which change between versions: it depends
    on the exact version of MJCZone.DapperMatic.AspNetCore it was built with, [x.y.z], never a range.
  -->
  <Target Name="PinDapperMaticVersion" AfterTargets="_GetProjectReferenceVersions">
    <ItemGroup>
      <_ProjectReferencesWithVersions Update="@(_ProjectReferencesWithVersions)" ProjectVersion="[%(_ProjectReferencesWithVersions.ProjectVersion)]" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>MJCZone.DapperMatic.AspNetCore.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="GraphQL" Version="8.8.5" />
    <PackageReference Include="GraphQL.MicrosoftDI" Version="8.8.5" />
    <PackageReference Include="GraphQL.Server.Transports.AspNetCore" Version="8.3.3" />
    <PackageReference Include="GraphQL.SystemTextJson" Version="8.8.5" />
  </ItemGroup>
</Project>
