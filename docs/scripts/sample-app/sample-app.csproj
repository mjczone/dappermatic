<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SampleApp</RootNamespace>
    <AssemblyName>sample-app</AssemblyName>
    <!--
      Emit the OpenAPI document at build time straight into the docs api-browser folder.
      This replaces the old "run the app and scrape /swagger/v1/swagger.json" step.
    -->
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)/../../api-browser</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--file-name openapi</OpenApiGenerateDocumentsOptions>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageReference
      Include="Microsoft.Extensions.ApiDescription.Server"
      Version="10.0.11"
      PrivateAssets="All"
    />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../../src/MJCZone.DapperMatic.AspNetCore/MJCZone.DapperMatic.AspNetCore.csproj" />
  </ItemGroup>
</Project>
